APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
COMPOSE_PROJECT_NAME=local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=siabes_api
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=siabes-redis
REDIS_PASSWORD=redis_password
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
DEFAULT_LOCATION_ID=

# ===================================
# Docker Configuration
# ===================================
DOCKER_COMPOSE_FILE=docker-compose.yml
DOCKER_SERVICE_PHP_FPM=siabes-php-fpm
DOCKER_SERVICE_NGINX=siabes-nginx

# Container Names
NGINX_CONTAINER_NAME=nginx
PHP_CONTAINER_NAME=php
REDIS_CONTAINER_NAME=redis
DB_CONTAINER_NAME=postgres

# Version Settings
PHP_VERSION=8.4
POSTGRES_VERSION=17-master

# Port Configuration
NGINX_PORT=80
NGINX_HTTPS_PORT=443
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379

# SSL Configuration
SSL_CERT_PATH=./.docker/nginx/ssl
SSL_CERT_DEST=/etc/nginx/ssl

# System Settings
APP_TIMEZONE=America/Boa_Vista
ULIMITS_NOFILE_SOFT=65536
ULIMITS_NOFILE_HARD=1048576

# PHP OPCache Configuration
PHP_OPCACHE_MEMORY_CONSUMPTION=500
PHP_OPCACHE_VALIDATE_TIMESTAMPS=0
PHP_OPCACHE_MAX_ACCELERATED_FILES=20000
PHP_OPCACHE_MAX_WASTED_PERCENTAGE=15
PHP_OPCACHE_REVALIDATE_FREQ=0
PHP_OPCACHE_INTERNED_STRINGS_BUFFER=32
PHP_OPCACHE_ENABLE_CLI=1
PHP_OPCACHE_SAVE_COMMENTS=1
PHP_OPCACHE_HUGE_CODE_PAGES=1
PHP_OPCACHE_FILE_CACHE=/tmp/opcache

# Linux User/Group IDs (for Docker)
ID_GROUP_LINUX=1001
ID_USER_LINUX=1001


TEST_PASSWORD=
